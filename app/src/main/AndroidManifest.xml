<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    >
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <application android:label="Factorio" android:appCategory="game" android:theme="@style/AppTheme"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:resizeableActivity="true"
        android:allowBackup="false" android:supportsRtl="true"
        android:usesCleartextTraffic="false" android:extractNativeLibs="true">
        <provider android:name="org.factorio.local.launcher.GameDocumentsProvider"
            android:authorities="org.factorio.local.launcher.documents"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <activity android:name="org.factorio.local.launcher.MainActivity" android:exported="true"
            android:screenOrientation="sensorLandscape" android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.termux.x11.MainActivity" android:exported="true"
            android:resizeableActivity="true" android:process=":window" android:launchMode="singleTask" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|locale|layoutDirection" />

    </application>
</manifest>
